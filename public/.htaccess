# PaiseWise — Apache / LiteSpeed settings for Hostinger.
# Copied into dist/ by the build; upload it with the rest of dist/.

Options -Indexes
DirectoryIndex index.html

# One address for every page: https://paisewise.in (no www, no http).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://paisewise.in%{REQUEST_URI} [L,R=301]
</IfModule>

# Missing pages get the site's own 404 page (with a real 404 status).
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

# Compress text files.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml application/xml
</IfModule>

# Caching. Asset names are not content-hashed (index.js, style.css), so
# browsers revalidate HTML/JS/CSS on each visit (cheap 304s) and an
# update shows up immediately. Fonts and icons never change: cache long.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(woff2|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
